module and_gate_tb;
reg a;
reg b;
wire y;
and_gate uut (
.a(a),
.b(b),
.y(y)
);
reg clk = 0;
always #5 clk = ~clk;
initial begin
$dumpfile("waveform.vcd"); 
$dumpvars(0, and_gate_tb); 
$display("Time a b y");
a = 0; b = 0;
#10 $display("%0t %b %b %b", $time, a, b, y);
a = 0; b = 1;
#10 $display("%0t %b %b %b", $time, a, b, y);
a = 1; b = 0;
#10 $display("%0t %b %b %b", $time, a, b, y);
a = 1; b = 1;
#10 $display("%0t %b %b %b", $time, a, b, y);
$finish;
end

endmodule
