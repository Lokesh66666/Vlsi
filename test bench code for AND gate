
module and_gate_tb;
// Inputs
reg a;
reg b;
// Output
wire y;
// Instantiate the AND gate
and_gate uut (
.a(a),
.b(b),
.y(y)
);
// Clock generation
reg clk = 0;
always #5 clk = ~clk;
// Enable waveform dumping
initial begin
$dumpfile("waveform.vcd"); // Specify the waveform file name
$dumpvars(0, and_gate_tb); // Dump all signals in the current module
$display("Time a b y");
a = 0; b = 0;
#10 $display("%0t %b %b %b", $time, a, b, y);
a = 0; b = 1;
#10 $display("%0t %b %b %b", $time, a, b, y);
a = 1; b = 0;
#10 $display("%0t %b %b %b", $time, a, b, y);
a = 1; b = 1;
#10 $display("%0t %b %b %b", $time, a, b, y);
$finish;
end
endmodule