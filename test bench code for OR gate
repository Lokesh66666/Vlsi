reg a, b;
wire y;
or_gate u1 (
.a(a),
.b(b),
.y(y)
);
initial begin
$dumpfile("waveform.vcd");
$dumpvars(0, testbench); 
a = 0;
b = 0;
#10 a = 0; b = 1;
#10 a = 1; b = 0;
